u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u0441\u043f\u0440\u043e\u0431\u0456 \u0432\u0448\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0413\u0435\u0440\u043e\u0457\u0432 \u0411\u0430\u0437\u0430\u0440\u0443 (MALYN.MEDIA) 2023), \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0438\u0437\u0431\u0438\u0442\u043e\u0433\u043e \u043f\u043e\u043b\u0438\u0442\u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0412\u0430\u0441\u0438\u043b\u044f \u041e\u0432\u0441\u0438\u0435\u043d\u043a\u043e(Citation: \u0406\u043d\u0442\u0435\u0440\u0432'\u044e \u0412\u0430\u0441\u0438\u043b\u044f \u041e\u0432\u0441\u0456\u0454\u043d\u043a\u0430 (\u041c\u0443\u0437\u0435\u0439 \u0434\u0438\u0441\u0438\u0434\u0435\u043d\u0442\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0443\u0445\u0443) 2011), \u0441\u043c\u0435\u0440\u0442\u044c \u0440\u0443\u0445\u043e\u0432\u0446\u0430 \u0415\u0432\u0433\u0435\u043d\u0438\u044f \u041c\u0435\u043b\u0435\u043d\u0438\u0432\u0441\u043a\u043e\u0433\u043e - \u043f\u043e\u0441\u043b\u0435 \u00ab\u0431\u0435\u0441\u0435\u0434\u044b\u00bb \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u043d\u043e\u043c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u041c\u0412\u0414 \u043e\u043d \u00ab\u0443\u043c\u0435\u0440 \u043f\u043e \u0434\u043e\u0440\u043e\u0433\u0435 \u0434\u043e\u043c\u043e\u0439\u00bb(Citation: \u041d\u0430\u0446\u0456\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0439 \u043f\u0440\u0430\u043f\u043e\u0440 \u043d\u0430\u0434 \u0416\u0438\u0442\u043e\u043c\u0438\u0440\u043e\u043c: \u0456\u0441\u0442\u043e\u0440\u0456\u044f \u0442\u0430 \u0431\u043e\u0440\u043e\u0442\u044c\u0431\u0430 \u0437\u0430 \u043d\u044c\u043e\u0433\u043e (\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0438\u0439 \u0442\u0438\u0436\u0434\u0435\u043d\u044c) 2010), \u0430 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 - \u00ab\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0430\