442\u0430 \u00ab\u041e\u0431 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435 \u0440\u0443\u0441\u0441\u043a\u0438\u0445 \u0438 \u0443\u043a\u0440\u0430\u0438\u043d\u0446\u0435\u0432\u00bb (\u0438\u044e\u043b\u044c 2021), \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u043f\u0441\u0435\u0432\u0434\u043e\u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0438\u0444: \u00ab\u0440\u0443\u0441\u0441\u043a\u0438\u0435 \u0438 \u0443\u043a\u0440\u0430\u0438\u043d\u0446\u044b \u2013 \u043e\u0434\u0438\u043d \u043d\u0430\u0440\u043e\u0434, \u0435\u0434\u0438\u043d\u043e\u0435 \u0446\u0435\u043b\u043e\u0435\u00bb, \u0430 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043e\u0431\u044a\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u00ab\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0435\u0432\u0438\u043a\u043e\u0432 \u043f\u043e \u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044e \u043e\u0442 \u0420\u043e\u0441\u0441\u0438\u0438 \u0435\u0451 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0439 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0430\u043a\u0442\u043e\u043c \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f\u00bb(Citation: \u0421\u0442\u0430\u0442\u044c\u044f \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u041f\u0443\u0442\u0438\u043d\u0430 \u00ab\u041e\u0431 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435 \u0440\u0443\u0441\u0441\u043a\u0438\u0445 \u0438 \u0443\u043a\u0440\u0430\u0438\u043d\u0446\u0435\u0432\u00bb 2021). \u0412 \u0442\u043e\u0439 \u0436\u0435 \u0441\u0442\u0430\u0442\u044c\u0435 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u043a\u0430\u043a \u041b\u0435\u043d\u0438\u043d \u043b\u0438\u0447\u043d\u043e \u00ab\u0443\u0431\u0435\u0436\u0434\u0430\u043b\u00bb \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u0414\u043e\u043d\u0435\u0446\u043a\u043e-\u041a\u0440\u0438\u0432\u043e\u0440\u043e\u0436\u0441\u043a\u043e\u0439 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u00ab\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u0441\u043e\u0441\u0442\u0430\u0432\u0435 \u0421\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u0439 \u0423\u043a\u0440\u0430\u0438\u043d\u044b\u00bb, \u0430 \u0426\u041a \u0420\u041a\u041f(\u0431) \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u00ab\u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u0430 \u0441\u044a\u0435\u0437\u0434\u0435 \u201e\u043e\u0434\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0423\u043a\u0440\u0430\u0438\u043d\u044b\u201c\u00bb(Citation: \u0421\u0442\u0430\u0442\u044c\u044f \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u041f\u0443\u0442\u0438\u043d\u0430 \u00ab\u041e\u0431 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435 \u0440\u0443\u0441\u0441\u043a\u0438\u0445 \u0438 \u0443\u043a\u0440\u0430\u0438\u043d\u0446\u0435\u0432\u00bb 2021). \u041d\u0430\u043a\u0430\u043d\u0443\u043d\u0435 \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0442\u0435\u0437\u0438\u0441 \u0434\u043e\u0432\u0435\u0434\u0451\u043d \u0434\u043e \u043f\u0440\u0435\u0434\u0435\u043b\u0430: \u0432 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0438 21 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 2022 \u0433\u043e\u0434\u0430 \u041f\u0443\u0442\u0438\u043d \u043e\u0431\u044a\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u00ab\u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0423\u043a\u0440\u0430\u0438\u043d\u0430 \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0431\u044b\u043b\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0420\u043e\u0441\u0441\u0438\u0435\u0439, \u0442\u043e\u0447\u043d\u0435\u0435, \u0431\u043e\u043b\u044c\u0448\u0435\u0432\u0438\u0441\u0442\u0441\u043a\u043e\u0439, \u043a\u043e\u043c\u043c\u0443\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0420\u043e\u0441\u0441\u0438\u0435\u0439\u00bb, \u0430 \u0441\u0442\u0440\u0430\u043d\u0443 \u043d\u0430\u0437\u0432\u0430\u043b \u00ab\u0423\u043a\u0440\u0430\u0438\u043d\u0430 \u0438\u043c\u0435\u043d\u0438 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0430 \u0418\u043b\u044c\u0438\u0447\u0430 \u041b\u0435\u043d\u0438\u043d\u0430\u00bb - \u00ab\u041e\u043d \u0435\u0451 \u0430\u0432\u0442\u043e\u0440 \u0438 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440\u00bb(Citation: \u041e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u041f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 21 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 2022 \u0433\u043e\u0434\u0430 2022).", "score": 1, "color": "#66b1ff", "showSubtechniques": false}], "gradient": {"colors": ["#ffffff", "#66b1ff"], "minValue": 0, "maxValue": 1}, "legendItems": [{"label": "used by \u0418\u0434\u0435\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u043a \u043f\u043e\u043b\u043d\u043e\u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u043e\u043c\u0443 \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044e (2020\u20132021)", "color": "#66b1ff"}]}