7) 1881) - \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u043f\u0440\u0438\u0441\u044f\u0433\u0438 \u043f\u043e\u0448\u043b\u0438 \u043e\u0434\u043d\u0430 \u0437\u0430 \u0434\u0440\u0443\u0433\u043e\u0439. \u0421\u0430\u043c \u0424\u0435\u0437\u0435 \u0434\u043e\u043b\u043e\u0436\u0438\u043b \u0440\u0430\u0441\u0447\u0451\u0442 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0443 \u0412\u0435\u043b\u044c\u044f\u043c\u0438\u043d\u043e\u0432\u0443 15 \u043c\u0430\u0440\u0442\u0430 1837: \u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u00ab\u0432 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u0442\u0440\u0430\u0445\u043e\u043c\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u043e\u0441\u043b\u0435 \u0431\u043e\u044f \u043f\u0440\u0438 \u0410\u0432\u0442\u0443\u0440\u0430\u0445 \u00ab\u043e\u0431\u044a\u044f\u0442\u044b \u0431\u044b\u043b\u0438 \u0442\u0430\u0432\u043b\u0438\u043d\u0446\u044b \u0438 \u0430\u043d\u0434\u0438\u0439\u0446\u044b\u00bb(Citation: \u0414\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0433\u043e\u0440\u0446\u0435\u0432 \u0441\u0435\u0432\u0435\u0440\u043e-\u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u041a\u0430\u0432\u043a\u0430\u0437\u0430 \u0432 20-50 \u0433\u0433. XIX \u0432\u0435\u043a\u0430: \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 1959); \u0442\u0435\u043c \u0436\u0435 \u0441\u043b\u043e\u0432\u043e\u043c \u0440\u0430\u043f\u043e\u0440\u0442 \u0420\u043e\u0437\u0435\u043d\u0430 \u043e\u0442 11 \u043c\u0430\u0440\u0442\u0430 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u0438\u044f \u043e\u0442 \u0430\u043d\u0434\u0438\u0439\u0446\u0435\u0432 - \u00ab\u0436\u0435\u043b\u0430\u044f \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0441\u0442\u0440\u0430\u0445\u043e\u043c\u00bb(Citation: \u0410\u043a\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u044e \u0430\u0440\u0445\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u044e \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u044e. \u0422\u043e\u043c VIII (1831-1837) 1881). \u0421\u0442\u0440\u0430\u0445 \u0433\u043d\u0430\u043b \u043b\u044e\u0434\u0435\u0439 \u0441 \u0437\u0435\u043c\u043b\u0438: \u043f\u043e\u0441\u043b\u0435 \u043c\u0430\u0440\u0442\u043e\u0432\u0441\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0432 \u043f\u043e \u043b\u0435\u0441\u0430\u043c \u0436\u0438\u0442\u0435\u043b\u0438, \u043f\u043e \u0440\u0430\u043f\u043e\u0440\u0442\u0443 \u043e\u0442 12 \u0430\u043f\u0440\u0435\u043b\u044f, \u00ab\u0441\u0438\u043c\u0438 \u043f\u043e\u0438\u0441\u043a\u0430\u043c\u0438 \u043f\u0440\u0438\u043d\u0443\u0436\u0434\u0435\u043d\u044b \u0431\u044b\u043b\u0438 \u0443\u0439\u0442\u0438 \u0432 \u043e\u0442\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0435 \u0433\u043e\u0440\u044b\u00bb(Citation: \u0410\u043a\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u044e \u0430\u0440\u0445\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u044e \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u044e. \u0422\u043e\u043c VIII (1831-1837) 1881).", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0105", "comment": "\u0412\u0435\u0441\u0435\u043d\u043d\u0438\u0439 \u0442\u0443\u0440 \u0424\u0435\u0437\u0435 (\u0444\u0435\u0432\u0440\u0430\u043b\u044c-\u0430\u043f\u0440\u0435\u043b\u044c 1837) \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0