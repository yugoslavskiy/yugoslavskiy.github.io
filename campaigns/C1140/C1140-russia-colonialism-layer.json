u0432\u043e\u0439\u0441\u043a\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0430 \u0411\u0443\u043b\u0433\u0430\u043a\u043e\u0432\u0430 \u043a\u0430\u043a \u00ab\u043f\u0440\u0438\u0448\u0435\u0434\u0448\u0438\u0445 \u0441 \u043e\u0433\u043d\u0451\u043c \u0438 \u043c\u0435\u0447\u043e\u043c \u043d\u0430 \u0447\u0435\u0447\u0435\u043d\u0441\u043a\u0443\u044e \u0437\u0435\u043c\u043b\u044e\u00bb, \u0430 \u0425\u0430\u043d\u043a\u0430\u043b\u044c\u0441\u043a\u043e\u0435 \u0441\u0440\u0430\u0436\u0435\u043d\u0438\u0435 1807 \u0433\u043e\u0434\u0430 \u2014 \u043a\u0430\u043a \u043a\u0440\u043e\u0432\u043e\u043f\u0440\u043e\u043b\u0438\u0442\u043d\u043e\u0435(Citation: \u0427\u0435\u0447\u0435\u043d\u0446\u044b \u0432 \u0420\u0443\u0441\u0441\u043a\u043e-\u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u0439 \u0432\u043e\u0439\u043d\u0435 1998). \u0412 \u0444\u0435\u0432\u0440\u0430\u043b\u0435 1807 \u0433\u043e\u0434\u0430 \u0442\u0440\u0438 \u043e\u0442\u0440\u044f\u0434\u0430 \u043f\u043e\u0434 \u043e\u0431\u0449\u0438\u043c \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u043a\u043e\u043c\u0430\u043d\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0435\u0439 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0430 \u0411\u0443\u043b\u0433\u0430\u043a\u043e\u0432\u0430 \u043f\u0435\u0440\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u0438\u0441\u044c \u0437\u0430 \u0422\u0435\u0440\u0435\u043a; 13 \u0444\u0435\u0432\u0440\u0430\u043b\u044f \u0432\u043e\u0439\u0441\u043a\u0430 \u0448\u0442\u0443\u0440\u043c\u043e\u043c \u043f\u0440\u043e\u0440\u0432\u0430\u043b\u0438 \u0425\u0430\u043d\u043a\u0430\u043b\u044c\u0441\u043a\u043e\u0435 \u0443\u0449\u0435\u043b\u044c\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u0443\u043a\u0440\u0435\u043f\u0438\u043b\u0438 \u0437\u0430\u0432\u0430\u043b\u0430\u043c\u0438, \u0440\u0432\u0430\u043c\u0438 \u0438 \u0437\u0430\u0441\u0435\u043a\u0430\u043c\u0438. \u041a\u043e\u043c\u0430\u043d\u0434\u0443\u044e\u0449\u0438\u0439 \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0435\u0439 \u0433\u0435\u043d\u0435\u0440\u0430\u043b \u0411\u0443\u043b\u0433\u0430\u043a\u043e\u0432 \u0434\u043e\u043d\u043e\u0441\u0438\u043b, \u0447\u0442\u043e \u0432\u043e\u0448\u0451\u043b \u00ab\u0434\u043b\u044f \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u00bb \u043e\u0431\u0449\u0435\u0441\u0442\u0432 \u043d\u043e\u0445\u0447\u0438, \u0447\u0442\u043e \u0436\u0438\u0442\u0435\u043b\u0438, \u0441\u043e\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044c \u0447\u0438\u0441\u043b\u043e\u043c \u043e\u043a\u043e\u043b\u043e 10,000, \u00ab\u0440\u0435\u0448\u0430\u0441\u044c \u043f\u043e\u0433\u0438\u0431\u043d\u0443\u0442\u044c, \u043d\u0435\u0436\u0435\u043b\u0438 \u0447\u0440\u0435\u0437 \u0443\u0449\u0435\u043b\u044c\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0435 \u0432\u043e\u0439\u0441\u043a\u043e\u00bb; \u043f\u0440\u0438 \u0448\u0442\u0443\u0440\u043c\u0435 \u0443\u0449\u0435\u043b\u044c\u044f, \u0438\u0437 \u043e\u0431\u043e\u0440\u043e\u043d\u044f\u0432\u0448\u0438\u0445\u0441\u044f \u0447\u0435\u0447\u0435\u043d\u0446\u0435\u0432, \u043f\u043e \u0435\u0433\u043e \u0440\u0430\u043f\u043e\u0440\u0442\u0443, \u00ab\u043e\u043a\u043e\u043b\u043e 1,000 \u0443\u0431\u0438\u0442\u044b\u0445 \u0442\u0435\u0445 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435\u00bb(Citation: \u0410\u043a\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u044e \u0430\u0440\u0445\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u044e \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u044e. \u0422\u043e\u043c III (1806-1809) 1869). \u0418\u043c\u043f\u0435\