3f\u043e\u0437\u0438\u0446\u0438\u0438 \u0412. \u042e\u0449\u0435\u043d\u043a\u043e \u0432 \u0440\u0430\u0437\u0433\u0430\u0440 \u043f\u0440\u0435\u0434\u0432\u044b\u0431\u043e\u0440\u043d\u043e\u0439 \u043a\u0430\u043c\u043f\u0430\u043d\u0438\u0438 \u043f\u0443\u0442\u0435\u043c \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0438\u043e\u043a\u0441\u0438\u043d\u043e\u043c: \u0432 \u043a\u043e\u043d\u0446\u0435 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 2004 \u0433\u043e\u0434\u0430 \u00ab\u043f\u0430\u0446\u0438\u0435\u043d\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b \u0441 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0422\u0425\u0414\u0414; \u0443\u0440\u043e\u0432\u043d\u0438 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u0435\u0433\u043e \u043a\u0440\u043e\u0432\u0438 (108000 \u043f\u0433/\u0433 \u043b\u0438\u043f\u0438\u0434\u043d\u043e\u0439 \u043c\u0430\u0441\u0441\u044b) \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \u0432 50 000 \u0440\u0430\u0437 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f\u00bb(Citation: TCDD poisoning in Victor Yushchenko (The Lancet) 2009). \u041e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a \u0442\u044f\u0436\u0435\u043b\u043e\u043c\u0443 \u043e\u0431\u0435\u0437\u043e\u0431\u0440\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u044e \u043b\u0438\u0446\u0430 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430.", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0012", "comment": "\u0418\u043d\u0441\u043f\u0438\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0433\u0440\u043e\u0437\u044b \u0440\u0430\u0441\u043a\u043e\u043b\u0430 \u0441\u0442\u0440\u0430\u043d\u044b \u0432 \u043e\u0442\u0432\