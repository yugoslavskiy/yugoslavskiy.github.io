43a\u0438\u0435 \u043e\u0441\u0430\u0434\u043d\u0438\u043a\u0438, \u043f\u043e\u043c\u0435\u0449\u0438\u043a\u0438, \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u044b \u0437\u0430\u0432\u043e\u0434\u043e\u0432 \u0438 \u0444\u0430\u0431\u0440\u0438\u043a \u0438 \u0438\u0445 \u0441\u0435\u043c\u044c\u0438\u00bb; \u0432\u0441\u0435\u0433\u043e \u00ab\u0432\u044b\u0432\u0435\u0437\u0435\u043d\u043e \u0432 \u043e\u0442\u0434\u0430\u043b\u0451\u043d\u043d\u044b\u0435 \u0440\u0435\u0433\u0438\u043e\u043d\u044b \u0421\u0421\u0421\u0420 \u0434\u043e 1 \u043c\u043b\u043d 250 \u0442\u044b\u0441. \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u00bb(Citation: \u0414\u0435\u043f\u043e\u0440\u0442\u0430\u0446\u0456\u044f (\u0415\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0456\u044f \u0421\u0443\u0447\u0430\u0441\u043d\u043e\u0457 \u0423\u043a\u0440\u0430\u0457\u043d\u0438) 2007). \u0412\u043e\u043b\u043d\u044b \u0431\u044b\u043b\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u044c\u043d\u044b\u043c\u0438: \u043e\u0441\u0430\u0434\u043d\u0438\u043a\u043e\u0432 \u0432\u044b\u0441\u0435\u043b\u044f\u043b\u0438 \u043f\u043e \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044e \u0421\u041d\u041a \u0421\u0421\u0421\u0420 \u043e\u0442 5 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1939 \u0433\u043e\u0434\u0430 \u2116 2010-558\u0441\u0441 - \u0435\u0433\u043e \u0442\u0435\u043a\u0441\u0442 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0432 \u0437\u0430\u043a\u0440\u044b\u0442\u043e\u043c \u0410\u0440\u0445\u0438\u0432\u0435 \u041f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430 \u0420\u0424 (\u0444\u043e\u043d\u0434 93), \u0430 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043f\u043e \u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u041d\u041a\u0412\u0414, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u043e\u0439 29 \u0434\