0443\u043b\u043b\u043e \u043d\u044b\u043d\u0435 \u0436\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0442\u0438\u0432 \u043d\u0435\u043f\u043e\u043a\u043e\u0440\u043d\u044b\u0445 \u0447\u0435\u0447\u0435\u043d\u0441\u043a\u0438\u0445 \u0434\u0435\u0440\u0435\u0432\u0435\u043d\u044c\u00bb(Citation: \u0410\u043a\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u044e \u0430\u0440\u0445\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u044e \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u044e. \u0422\u043e\u043c VIII (1831-1837) 1881). \u0417\u0430 \u0447\u0435\u0442\u044b\u0440\u0435 \u0434\u043d\u044f \u0440\u0435\u0439\u0434\u0430 \u0434\u0435\u0440\u0435\u0432\u043d\u044f \u0431\u044b\u043b\u0430 \u0438\u0441\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0430 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 76 \u0436\u0438\u0442\u0435\u043b\u044f\u043c\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u043d\u0438\u043a\u0430\u043c\u0438, 40 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0432\u0435\u0434\u0435\u043d\u044b \u0432 \u043f\u043b\u0435\u043d(Citation: \u0414\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0433\u043e\u0440\u0446\u0435\u0432 \u0441\u0435\u0432\u0435\u0440\u043e-\u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u041a\u0430\u0432\u043a\u0430\u0437\u0430 \u0432 20-50 \u0433\u0433. XIX \u0432\u0435\u043a\u0430: \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 1959).", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0164", "comment": "\u041f\u0440\u0438 \u0438\u0441\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0438 \u041a\u0438\u0448\u043a\u0435\u0440\u043e\u0439-\u042e\u0440\u0442\u0430 28-31 \u0434\u0435\u043a\u0430\u0431\u0440\u044f 1836 \u043e\u0442\u0440\u044f\u0434 \u041f\u0443\u043b\u043b\u043e \u043f\u0440\u0