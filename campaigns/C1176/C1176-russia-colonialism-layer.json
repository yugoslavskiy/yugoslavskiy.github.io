0433.; \u0432 \u043c\u0430\u0440\u0442\u0435-\u0430\u0432\u0433\u0443\u0441\u0442\u0435 1921 \u0433. \u0431\u044b\u043b\u0438 \u0440\u0430\u0437\u043e\u0440\u0443\u0436\u0435\u043d\u044b \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u0435 \u0432 \u043c\u044f\u0442\u0435\u0436\u0435 \u041d. \u0413\u043e\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0447\u0435\u0447\u0435\u043d\u0441\u043a\u0438\u0435 \u0430\u0443\u043b\u044b \u0413\u043e\u0440\u0434\u0430\u043b\u0438, \u0426\u0435\u043d\u0442\u043e\u0440\u043e\u0439, \u0411\u0435\u043b\u0433\u0430\u0442\u043e\u0439, \u0414\u0430\u0440\u0433\u043e, \u0411\u0435\u043d\u043e\u0439, \u0412\u0435\u0434\u0435\u043d\u043e, \u0413\u0440\u043e\u0437\u043d\u0435\u043d\u0441\u043a\u0438\u0439, \u0428\u0430\u043b\u0438\u00bb(Citation: \u041f\u043e\u0432\u0441\u0442\u0430\u043d\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u0421\u0435\u0432\u0435\u0440\u043d\u043e\u043c \u041a\u0430\u0432\u043a\u0430\u0437\u0435 \u0432 1920-1925 \u0433\u043e\u0434\u0430\u0445 2013). \u0412 \u043c\u0430\u0435 1922 \u0433\u043e\u0434\u0430 \u0432\u043e\u0439\u0441\u043a\u0430, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0432 \u0427\u0435\u0447\u043d\u044e, \u0432\u043e\u0437\u0433\u043b\u0430\u0432\u0438\u043b \u0413\u0438\u043a\u0430\u043b\u043e - \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044c \u0413\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u043a\u043e\u043c\u0430 \u043f\u0430\u0440\u0442\u0438\u0438(Citation: \u0413\u0438\u043a\u0430\u043b\u043e (\u0411\u0421\u042d) 1971), \u0432 \u0432\u043e\u0439\u043d\u0443 \u0441 \u0414\u0435\u043d\u0438\u043a\u0438\u043d\u044b\u043c \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0432\u0430\u0432\u0448\u0438\u0439 \u043f\u043e\u0432\u0441\u0442\u0430\u043d\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043e\u0442\u0440\u044f\u0434\u0430\u043c\u0438 \u0432 \u0433\u043e\u0440\u0430\