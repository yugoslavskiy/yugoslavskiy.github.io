9 \u043f\u043e\u0441\u043e\u043b \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0432 \u0432\u0456\u0434\u043c\u043e\u0432\u043e\u044e - \u0437\u0430 \u0437\u0432\u0456\u0442\u043e\u043c \u0441\u0430\u043c\u043e\u0433\u043e \u043f\u043e\u0441\u043e\u043b\u044c\u0441\u0442\u0432\u0430, \u043f\u0440\u0438\u0441\u044f\u0433\u0430\u0442\u0438 \u0437\u0430 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u044f \u00ab\u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u0431\u0443\u0432\u0430\u043b\u043e \u0430\u043d\u0456 \u0431\u0443\u0434\u0435, \u0456 \u0433\u0435\u0442\u044c\u043c\u0430\u043d\u043e\u0432\u0456 \u043d\u0430\u0432\u0456\u0442\u044c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0438 \u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0435 \u043b\u0438\u0447\u0438\u0442\u044c, \u0431\u043e \u0432\u0441\u044f\u043a\u0438\u0439 \u043f\u0456\u0434\u0434\u0430\u043d\u0438\u0439 \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u043f\u0440\u0438\u0441\u044f\u0433\u0430\u0442\u0438 \u0441\u0432\u043e\u043c\u0443 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0435\u0432\u0456\u00bb(Citation: \u0406\u0441\u0442\u043e\u0440\u0456\u044f \u0423\u043a\u0440\u0430\u0457\u043d\u0438-\u0420\u0443\u0441\u0438: \u0422. IX 1931); \u0425\u043c\u0435\u043b\u044c\u043d\u0438\u0446\u044c\u043a\u043e\u043c\u0443 \u0434\u043e\u0432\u0435\u043b\u043e\u0441\u044f \u0442\u0440\u0438\u0447\u0456 \u0437\u0430 \u0434\u0435\u043d\u044c 18 (8) \u0441\u0456\u0447\u043d\u044f 1654 \u0441\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0440\u0430\u0434\u0443, \u0430\u043b\u0435 \u0412.\u0411\u0443\u0442\u0443\u0440\u043b\u0456\u043d, \u043f\u043e\u0441\u043b\u0430\u0432\u0448\u0438\u0441\u044c \u043d\u0430 \u0441\u0430\u043c\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u043d\u0438\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0432\u043b\u0430\u0434\u0438 \u0440\u043e\u0441. \u043c\u043e\u043d\u0430\u0440\u0445\u0430, \u0432\u0456\u0434\u043c\u043e\u0432\u0438\u0432 \u0456 \u043