0456\u0448\u043b\u0438 \u043e\u0434\u043d\u0430 \u0437\u0430 \u043e\u0434\u043d\u043e\u044e. \u0421\u0430\u043c \u0424\u0435\u0437\u0435 \u0434\u043e\u043f\u043e\u0432\u0456\u0432 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043e\u043a \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0443 \u0412\u0435\u043b\u044c\u044f\u043c\u0456\u043d\u043e\u0432\u0443 15 \u0431\u0435\u0440\u0435\u0437\u043d\u044f 1837: \u0432\u0456\u043d \u0434\u0456\u044f\u0432 \u00ab\u0443 \u043d\u0430\u043c\u0456\u0440\u0456 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u043f\u043e \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u043f\u0430\u043d\u0456\u0447\u043d\u0438\u043c \u0441\u0442\u0440\u0430\u0445\u043e\u043c\u00bb, \u044f\u043a\u0438\u043c \u043f\u0456\u0441\u043b\u044f \u0431\u043e\u044e \u043f\u0440\u0438 \u0410\u0432\u0442\u0443\u0440\u0430\u0445 \u00ab\u043e\u0445\u043e\u043f\u043b\u0435\u043d\u0456 \u0431\u0443\u043b\u0438 \u0442\u0430\u0432\u043b\u0456\u043d\u0446\u0456 \u0439 \u0430\u043d\u0434\u0456\u0439\u0446\u0456\u00bb(Citation: \u0414\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0433\u043e\u0440\u0446\u0435\u0432 \u0441\u0435\u0432\u0435\u0440\u043e-\u0432\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u041a\u0430\u0432\u043a\u0430\u0437\u0430 \u0432 20-50 \u0433\u0433. XIX \u0432\u0435\u043a\u0430: \u0441\u0431\u043e\u0440\u043d\u0438\u043a \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 1959); \u0442\u0438\u043c \u0436\u0435 \u0441\u043b\u043e\u0432\u043e\u043c \u0440\u0430\u043f\u043e\u0440\u0442 \u0420\u043e\u0437\u0435\u043d\u0430 \u0432\u0456\u0434 11 \u0431\u0435\u0440\u0435\u0437\u043d\u044f \u043e\u043f\u0438\u0441\u0443\u0454 \u0432\u0438\u043c\u043e\u0433\u0443 \u043f\u043e\u043a\u0456\u0440\u043d\u043e\u0441\u0442\u0456 \u0437 \u0430\u043d\u0434\u0456\u0439\u0446\u0456\u0432 - \u00ab\u0431\u0430\u0436\u0430\u044e\u0447\u0438 \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u