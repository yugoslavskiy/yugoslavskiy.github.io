40\u0443. \u041f\u043e\u0442\u0456\u043c \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u043f\u0440\u043e\u043d\u0438\u043a\u043b\u0438 \u0432 \u0445\u0430\u0449\u0443 \u043b\u0456\u0441\u0443, \u0437\u043d\u0438\u0449\u0438\u043b\u0438 \u043a\u0443\u0442\u0430\u043d\u0438 (\u0437\u0438\u043c\u043e\u0432\u0456 \u0441\u043f\u043e\u0440\u0443\u0434\u0438 \u0434\u043b\u044f \u0445\u0443\u0434\u043e\u0431\u0438)\u00bb; 26 \u0431\u0435\u0440\u0435\u0437\u043d\u044f \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0437\u043d\u0438\u0449\u0443\u0432\u0430\u043b\u0438 \u043a\u0443\u0442\u0430\u043d\u0438 \u0431\u0456\u043b\u044f \u0428\u0430\u043b\u0456, \u0456 \u0441\u0432\u043e\u0457\u043c \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u043c \u0442\u0435 \u0436 \u0440\u043e\u0431\u0438\u043b\u0430 \u043a\u043e\u043b\u043e\u043d\u0430 \u0411\u0456\u0440\u0437\u0443\u043b\u044f(Citation: \u0410\u043a\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u041a\u0430\u0432\u043a\u0430\u0437\u0441\u043a\u043e\u044e \u0430\u0440\u0445\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u044e \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u044e. \u0422\u043e\u043c VIII (1831-1837) 1881).", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0121", "comment": "\u0417\u043d\u0438\u0449\u0443\u044e\u0447\u0438 \u0432 \u0431\u0435\u0440\u0435\u0437\u043d\u0456 1837 \u0440\u043e\u043a\u0443 \u043a\u0443\u0442\u0430\u043d\u0438 (\u0437\u0438\u043c\u043e\u0432\u0456 \u0441\u043f\u043e\u0440\u0443\u0434\u0438 \u0434\u043b\u044f \u0445\u0443\u0434\u043e\u0431\u0438) \u043f\u043e \u0414\u0436\u0430\u043b\u0446\u0456 \u0442\u0430 \u0431\u0456\u043b\u044f \u0428\u0430\u043b\u0456, \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0424\u0435\u0437\u0435 \u0446\u0456\u043b\u0435\u0441\u043f\u0440\u044f\u043c\u043e\u0432\u0430\u043d\u043e \u043f\u0430\u043b\u0438\u043b\u0438 \u043f\u0440\u043e\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\