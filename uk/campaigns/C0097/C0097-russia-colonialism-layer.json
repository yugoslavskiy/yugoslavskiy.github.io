7\u043e\u0433\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442 \u0434\u043e \u0404\u0421 \u0431\u0443\u043b\u043e \u00ab\u0440\u0456\u0437\u043a\u043e \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043e 6 \u0441\u0456\u0447\u043d\u044f \u0442\u0430 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043f\u0440\u0438\u043f\u0438\u043d\u0435\u043d\u043e \u0437 7 \u0441\u0456\u0447\u043d\u044f\u00bb, \u0430 \u0432 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u043f\u043e\u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043b\u0438\u0445 \u0431\u0430\u043b\u043a\u0430\u043d\u0441\u044c\u043a\u0438\u0445 \u043a\u0440\u0430\u0457\u043d\u0430\u0445 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0433\u0443\u043c\u0430\u043d\u0456\u0442\u0430\u0440\u043d\u0430 \u043d\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044f: \u00ab\u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u043d\u044f \u043d\u0435 \u043c\u043e\u0433\u043b\u0430 \u043e\u043f\u0430\u043b\u044e\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0434\u043e\u043c\u0456\u0432\u043a\u0438\u00bb(Citation: The Russo-Ukrainian gas dispute of January 2009 2009).", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0015", "comment": "\u041d\u0430\u0432'\u044f\u0437\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u0440\u0443\u043f\u0446\u0456\u0439\u043d\u0438\u0445 \u0441\u0445\u0435\u043c \u043f\u043e\u0441\u0442\u0430\u0447\u0430\u043d\u043d\u044f \u0433\u0430\u0437\u0443 \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u044e-\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u0438\u043a\u0430: \u041c\u043e\u0441\u043a\u0432\u0430 \u00ab\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u043b\u0430 \u043d\u0438\u0437\u043a\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0439-\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u0438\u043a\u0456\u0432 (