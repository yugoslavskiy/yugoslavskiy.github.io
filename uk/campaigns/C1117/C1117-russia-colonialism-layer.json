u0447 \u0432\u0438\u0434\u0430\u0432 \u0443\u043a\u0430\u0437 \u0434\u043e \u043f\u0440\u0438\u043a\u0430\u0437\u0443 \u041a\u0430\u0437\u0430\u043d\u0441\u044c\u043a\u043e\u0433\u043e \u043f\u0430\u043b\u0430\u0446\u0443, \u0449\u043e \u043f\u0440\u0438\u043f\u0438\u0441\u0443\u0432\u0430\u0432 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u043f\u0440\u0438\u0439\u0448\u043b\u0438\u0445 \u041d\u043e\u0445\u0447\u0456 (\u041c\u0456\u0447\u043a\u0456\u0437\u044f\u043d \u0442\u0430 \u041e\u043a\u043e\u0447\u0430\u043d) \u0456 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044f\u0432, \u0449\u043e \u0442\u0438\u0445 \u0456\u0437 \u043d\u0438\u0445, \u043a\u043e\u043c\u0443 \u00ab\u0432\u0456\u0440\u0438\u0442\u0438 \u0431\u0443\u0434\u0435 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430\u00bb, \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u00ab\u0437 \u0422\u0435\u0440\u0441\u044c\u043a\u043e\u0433\u043e \u043c\u0456\u0441\u0442\u0430 \u0432\u0435\u043b\u0456\u0442\u0438 \u0432\u0438\u0441\u0438\u043b\u0430\u0442\u0438 \u0433\u0435\u0442\u044c, \u0456 \u0432\u0435\u043b\u0456\u0442\u0438 \u0457\u043c \u0457\u0445\u0430\u0442\u0438 \u0442\u0443\u0434\u0438, \u0437\u0432\u0456\u0434\u043a\u0438 \u0445\u0442\u043e \u043f\u0440\u0438\u0457\u0445\u0430\u0432\u00bb(Citation: \u041a\u0430\u0431\u0430\u0440\u0434\u0438\u043d\u043e-\u0440\u0443\u0441\u0441\u043a\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0432 XVI-XVIII \u0432\u0432. \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b. \u0422\u043e\u043c I 1957); \u0434\u043b\u044f \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u043d\u0430\u0433\u043b\u044f\u0434\u0443 \u0432 \u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u043c\u0443 \u0440\u043e\u0437\u043f\u0438\u0441\u0456 \u0441\u043b\u0443\u0436\u0438\u043b\u0438\u043c \u043b\u044e\u0434\u044f\u043c \u043f\u043e \u043e\u0431\