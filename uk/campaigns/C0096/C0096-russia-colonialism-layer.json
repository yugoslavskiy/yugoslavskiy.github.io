43\u0440\u044f\u0434\u0443 \u0412.\u042f\u043d\u0443\u043a\u043e\u0432\u0438\u0447\u0430 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435: \u0432\u043e\u043d\u0438 \u0437\u043c\u043e\u0433\u043b\u0438 \u043d\u0430\u043f\u043e\u0432\u043d\u0438\u0442\u0438 \u0446\u0435 \u0437\u0440\u043e\u0441\u0442\u0430\u043d\u043d\u044f \u0433\u0430\u0440\u043d\u043e\u044e \u044f\u043a\u0456\u0441\u0442\u044e. \u0422\u043e\u0431\u0442\u043e \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u043a\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0440\u043e\u0437\u0432\u0438\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u0438\u0432\u0435\u0440\u0441\u0438\u0444\u0456\u043a\u043e\u0432\u0430\u043d\u043e\u00bb(Citation: \u041f\u0440\u044f\u043c\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0441 \u0436\u0438\u0442\u0435\u043b\u044f\u043c\u0438 \u0423\u043a\u0440\u0430\u0438\u043d\u044b 2004). \u041f\u0430\u0440\u0430\u043b\u0435\u043b\u044c\u043d\u043e \u043e\u043f\u043e\u043d\u0435\u043d\u0442\u0456\u0432 \u0434\u0435\u043c\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u043b\u0438, \u0437\u0432\u0438\u043d\u0443\u0432\u0430\u0447\u0443\u044e\u0447\u0438 \u0432 \u043d\u0430\u0446\u0456\u043e\u043d\u0430\u043b\u0456\u0437\u043c\u0456 \u0442\u0430 \u043f\u0440\u043e\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u044c\u043a\u0438\u0445 \u043f\u043e\u0433\u043b\u044f\u0434\u0430\u0445.", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0021", "comment": "\u0421\u043f\u0440\u043e\u0431\u0430 \u0444\u0456\u0437\u0438\u0447\u043d\u043e\u0433\u043e \u0443\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043b\u0456\u0434\u0435\u0440\u0430 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u043e\u0457 \u043e\u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u0412. \u042e\u0449\u0435\u043d\u043a\u0430 \u0432 \u0440\u043e\u0437\u043f\u0430\u043b \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0431\u043e\u0440\u0447\u043e\u0457 \u043a\u0430\u043c\u043f\u0430\u043d\u0456\u0457 \u0447\u0435\u0440\u0435\u0437 \u043e\u0442\u0440\u0443\u0454\u043d\u043d\u044f \u0434\u0456\u043e\u043a\u0441\u0438\u043d\u043e\u043c: \u043d\u0430\u043f\u0440\u0438\u043a\u0456\u043d\u0446\u0456 \u0433\u0440\u0443\u0434\u043d\u044f 2004 \u0440\u043e\u043a\u0443 \u00ab\u043f\u0430\u0446\u0456\u0454\u043d\u0442 \u043d\u0430\u0434\u0456\u0439\u0448\u043e\u0432 \u0437 \u043e\u0442\u0440\u0443\u0454\u043d\u043d\u044f\u043c \u0422\u0425\u0414\u0414; \u0440\u0456\u0432\u043d\u0456 \u0432 \u0441\u0438\u0440\u043e\u0432\u0430\u0442\u0446\u0456 \u0439\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u0456 (108000 \u043f\u0433/\u0433 \u043b\u0456\u043f\u0456\u0434\u043d\u043e\u0457 \u043c\u0430\u0441\u0438) \u0431\u0456\u043b\u044c\u0448 \u043d\u0456\u0436 \u0443 50 000 \u0440\u0430\u0437\u0456\u0432 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0432\u0430\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0438 \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u043d\u044f\u00bb(Citation: TCDD poisoning in Victor Yushchenko (The Lancet) 2009). \u041e\u0442\u0440\u0443\u0454\u043d\u043d\u044f \u043f\u0440\u0438\u0437\u0432\u0435\u043b\u043e \u0434\u043e \u0442\u044f\u0436\u043a\u043e\u0433\u043e \u0441\u043f\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043e\u0431\u043b\u0438\u0447\u0447\u044f \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430.", "score": 1, "color": "#66b1ff", "showSubtechniques": false}, {"techniqueID": "T0012", "comment": "\u0406\u043d\u0441\u043f\u0456\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0433\u0440\u043e\u0437\u0438 \u0440\u043e\u0437\u043a\u043e\u043b\u0443 \u043a\u0440\u0430\u0457\u043d\u0438 \u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u043d\u0430 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0438: \u043d\u0430 \u0437'\u0457\u0437\u0434\u0456 \u0432 \u0421\u0454\u0432\u0454\u0440\u043e\u0434\u043e\u043d\u0435\u0446\u044c\u043a\u0443 28 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2004 \u0440\u043e\u043a\u0443 \u0433\u043e\u043b\u043e\u0432\u0430 \u0444\u0440\u0430\u043a\u0446\u0456\u0457 \u00ab\u0420\u0435\u0433\u0456\u043e\u043d\u0456\u0432\u00bb \u0420. \u0411\u043e\u0433\u0430\u0442\u0438\u0440\u044c\u043e\u0432\u0430 \u0434\u0430\u043b\u0430 \u043f\u0440\u044f\u043c\u0443 \u043e\u0431\u0456\u0446\u044f\u043d\u043a\u0443 \u0441\u0435\u043f\u0430\u0440\u0430\u0442\u0438\u0441\u0442\u0441\u044c\u043a\u043e\u0433\u043e \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0434\u0443\u043c\u0443 - \u00ab\u043c\u0438 \u043d\u0430 \u043d\u044c\u043e\u0433\u043e \u0437 \u0432\u0430\u043c\u0438 \u043d\u0435 \u043f\u0456\u0434\u0435\u043c\u043e, \u043c\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0438\u043c\u0435\u043c\u043e \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0434\u0443\u043c \u043f\u0440\u043e \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u041f\u0456\u0432\u0434\u0435\u043d\u043d\u043e-\u0421\u0445\u0456\u0434\u043d\u043e\u0457 \u0434\u0435\u0440\u0436\u0430\u0432\u0438 (\u043e\u0432\u0430\u0446\u0456\u0457, \u043e\u043f\u043b\u0435\u0441\u043a\u0438)\u00bb(Citation: \u0421\u0442\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0421\u0435\u0432\u0435\u0440\u043e\u0434\u043e\u043d\u0435\u0446\u043a\u043e\u0433\u043e \u0441\u044a\u0435\u0437\u0434\u0430 2004). \u041f\u0440\u0438\u0441\u0443\u0442\u043d\u0456\u0441\u0442\u044c \u043e\u0444\u0456\u0446\u0456\u0439\u043d\u0438\u0445 \u043e\u0441\u0456\u0431 \u0420\u0424 \u043d\u0430\u0434\u0430\u0432\u0430\u043b\u0430 \u0446\u044c\u043e\u043c\u0443 \u0441\u0430\u043d\u043a\u0446\u0456\u044e \u041c\u043e\u0441\u043a\u0432\u0438: \u043c\u0435\u0440 \u041c\u043e\u0441\u043a\u0432\u0438 \u042e. \u041b\u0443\u0436\u043a\u043e\u0432 \u0437 \u0442\u0440\u0438\u0431\u0443\u043d\u0438 \u043d\u0430\u0433\u0430\u0434\u0430\u0432, \u0449\u043e \u00ab\u043d\u0430\u0448 \u041f\u0440\u0435\u0437\u0438\u0434\u0435\u